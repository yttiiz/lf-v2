---
import { getEntry } from "astro:content";
import { getProductsService } from "@services";
import type { HomeContentType, ProductCardContentType } from "@types";
import Hero from "./hero.astro";
import Products from "./products.astro";
import Visits from "./visits.astro";

let content = {} as HomeContentType;
let retrieveContent = await getEntry("home", "content");

if (retrieveContent) {
	content = { ...retrieveContent.data };
}

const productsData = await getProductsService("withReview");
let products: ProductCardContentType[] = [];

if (Array.isArray(productsData)) {
	products = productsData.map(
		({ details, description, name, thumbnail, pictures, _id, review }) => ({
			details,
			description,
			href: `/product/${_id.toString()}`,
			name: `Aka ${name}`,
			thumbnail,
			pictures,
			review,
		}),
	);
}
---

<div id="data-home">
	<section>
		<Hero content={content.hero} />
	</section>
	<section
		id="products"
		class="pt-[var(--header-site-height)]"
	>
		<Products content={content.apartments} products={products} />
	</section>
	<section
		id="visits"
		class="pt-[var(--header-site-height)]"
	>
		<Visits content={content.visits} />
	</section>
</div>
