---
import { IconLocation } from "@components/shared/Icons/mod";
import Link from "@components/shared/Link/Link.astro";
import type { VisitCardType } from "@types";
import { getUrl } from "@utils";

type Props = {
	items: VisitCardType[];
};

const { items } = Astro.props;
---

<ul class="grid gap-16 grid-cols-1">
	{
		items.map(
			({ image: { src, alt, author }, href, title, paragraph, location }) => (
				<li>
					<div class="grid gap-4 items-start lg:grid-rows-none lg:grid-cols-2 lg:gap-6">
						<figure class="relative">
							<img
								src={getUrl(src)}
								alt={alt}
								class="object-cover object-center aspect-video w-full rounded-xl"
								loading="lazy"
							/>
							<figcaption class="absolute bottom-4 right-4 py-1 px-3 rounded-full bg-dark/30 text-white text-xs">
								© {author}
							</figcaption>
						</figure>
						<div class="grid gap-2">
							<h3 class="text-2xl text-terciary">{title}</h3>
							<h4 class="flex items-center gap-1 text-primary">
								<IconLocation className="size-5 pb-0.5" />
								{location}
							</h4>
							<p class="line-clamp-5 overflow-hidden mb-2">{paragraph}</p>
							<div>
								<Link
									href={href}
									target="_blank"
									type="button"
									variant="white-bordered"
									value="En savoir plus"
								/>
							</div>
						</div>
					</div>
				</li>
			),
		)
	}
</ul>

<style>
	@media screen and (min-width: 1024px) {
		li:nth-child(even) {
			& figure {
				grid-area: 1 / 2 / 2 / 3;
			}
		}
	}
</style>
