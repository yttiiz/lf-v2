---
import H2 from "@components/shared/Heading/H2.astro";
import type { ApartmentsContentType } from "@types";
import { ProductsList } from "./ProductsList";

type Props = {
	content: ApartmentsContentType;
};

const { content } = Astro.props;
---

<div class="container flex flex-col gap-8">
	<div>
		<H2 children={content.title} />
		<p>{content.paragraph}</p>
	</div>
	<ProductsList client:load />
</div>
