---
import { Image } from "astro:assets";
import { IconArrowRight } from "@components/shared/Icons/mod";
import Link from "@components/shared/Link/Link.astro";
import type { HeroContentType } from "@types";
import FlamboyantFlower from "public/hero_banner.png";

type Props = {
	content: HeroContentType;
};

const {
	content: { title, imgAlt, paragraph, button },
} = Astro.props;
---

<div class="hero-banner flex items-center h-dvh">
	<div
		class="flex flex-col-reverse m-auto max-w-[var(--container-width)] lg:grid lg:grid-cols-2 gap-[var(--base-size)]"
	>
		<div class="text-white z-1">
			<h1 set:html={title} />
			<p set:html={paragraph} />
			<div class="flex">
				<Link
					value={button.textContent}
					type="button"
					href={button.href}
				>
					<IconArrowRight
						className="size-5"
						slot="endContent"
					/>
				</Link>
			</div>
		</div>
		<figure class="relative hidden md:block">
			<Image
				src={FlamboyantFlower}
				alt={imgAlt}
				class="relative z-1 aspect-video w-full object-cover object-center rounded-lg"
				priority
			/>
		</figure>
	</div>
</div>

<style>
	.hero-banner {
		background-image: linear-gradient(to top, #fb923c, #029cde);
		padding: 0 calc(var(--base-size) * 2);
	}

	.hero-banner > div {
		max-width: calc(var(--base-size) * 80);
	}

	h1 {
		font-size: calc(var(--base-size) * 4);
		font-weight: 500;
		line-height: calc(var(--base-size) * 4.5);
	}

	h1 + p {
		font-size: calc(var(--base-size) * 1.125);
		font-weight: 400;
		margin-top: calc(var(--base-size) * 0.825);
	}

	p {
		color: var(--color-white);
		margin-bottom: calc(var(--base-size) * 1.5);
	}

	figure::after {
		content: "";
		position: absolute;
		bottom: calc(var(--base-size) * -3);
		background: url(hero_banner.png);
		background-size: cover;
		width: 100%;
		height: 100%;
		opacity: 0.75;
		filter: blur(calc(var(--base-size) * 2));
	}

	img {
		background: linear-gradient(
			45deg,
			rgb(255 255 255 / 0.25) -70%,
			transparent 50%,
			rgb(255 255 255 / 0.25) 150%
		);
	}
</style>
